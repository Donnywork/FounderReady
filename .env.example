# Copy this file to .env in the repository root. Never commit credentials.
DATABASE_URL=postgresql://founderready:founderready_local@localhost:54329/founderready
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# For reasoning models that support it (such as gpt-6-luna), use none to disable reasoning.
# Leave unset for non-reasoning models such as gpt-4.1-mini.
# OPENAI_REASONING_EFFORT=none
APP_URL=http://localhost:3000
# Local HTTP only. Use true with HTTPS in production.
COOKIE_SECURE=false

# Integration tests require a separate disposable database.
# TEST_DATABASE_URL=postgresql://founderready:founderready_local@localhost:54329/founderready_test
