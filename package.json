{
  "name": "founder-ready",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": { "node": ">=24.21.0 <25" },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "pnpm --filter @founderready/web start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "pnpm --filter @founderready/web test:integration",
    "test:e2e": "pnpm --filter @founderready/web test:e2e",
    "docker:up": "docker compose up -d --wait",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f postgres",
    "docker:ps": "docker compose ps",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @founderready/web db:migrate"
  },
  "devDependencies": { "turbo": "2.11.10" }
}
